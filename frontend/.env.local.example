# URL du back-end Express fourni par OpenClassrooms.
# Pas de prefixe NEXT_PUBLIC_ : les appels se font cote serveur uniquement.
API_URL=http://localhost:3000

# Secret utilise par le back-end pour signer les JWT (phase 4).
# JWT_SECRET=dev-secret

# URL publique du site. Sert au sitemap, a robots.txt et aux balises Open Graph.
# En production, remplacer par l'URL Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
